  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "python3 -m http.server 3000 --directory out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "build:file": "next build && node scripts/build-file-preview.mjs",
